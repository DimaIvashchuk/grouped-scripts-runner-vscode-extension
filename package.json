{
  "name": "grouped-scripts-runner",
  "displayName": "Pkg Script Groups",
  "description": "Run nested scripts from package.json groupedScripts field with hover support",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DimaIvashchuk/grouped-scripts-runner-vscode-extension"
  },
  "icon": "assets/icon.png",
  "author": "Dmytro Ivashchuk <dmytro.ivashchuk.s@gmail.com> (https://github.com/DimaIvashchuk)",
  "publisher": "dmytro-ivashchuk",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "grouped-scripts-runner.runScript",
        "title": "Run Script"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.34.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
